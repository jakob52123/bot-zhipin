{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jakob52123/bot-zhipin/schema/bot.schema.json",
  "title": "bot.yaml",
  "description": "一个 Bot 的卡片和详情页信息。枚举值是全站唯一真源，网站和校验器都从这里读。",
  "type": "object",
  "additionalProperties": false,
  "required": ["slug", "name", "tagline", "category", "author", "addedAt", "prerequisites", "quotaCost", "permissions"],
  "properties": {
    "slug": {
      "description": "和文件夹同名。只能用小写字母、数字和短横线，2 到 40 个字符。",
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "minLength": 2,
      "maxLength": 40
    },
    "name": { "description": "Bot 的名字", "type": "string", "minLength": 1, "maxLength": 20, "pattern": "^[^<>\"]*$" },
    "nameZh": { "description": "中文叫法（可选）。名字不是中文时可以给一个，像岗位名，一眼看出它干什么；页面上以它为主，原名跟在后面", "type": "string", "minLength": 2, "maxLength": 20, "pattern": "^[^<>\"]*$" },
    "tagline": { "description": "一句话介绍", "type": "string", "minLength": 4, "maxLength": 40, "pattern": "^[^<>\"]*$" },
    "category": {
      "description": "分组",
      "enum": ["产品", "市场", "销售", "内容", "运营", "学习", "求职", "管家", "生活"]
    },
    "author": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "description": "作者名字", "type": "string", "minLength": 1, "maxLength": 40 },
        "github": {
          "description": "GitHub 用户名，不带 @",
          "type": "string",
          "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9]|-(?=[A-Za-z0-9])){0,38}$"
        },
        "url": { "description": "作者主页，只有外部收录且没有 GitHub 时才用", "type": "string", "pattern": "^https://" }
      }
    },
    "platform": {
      "description": "在哪个平台上用（可选）。不写就是 Grok Bot；OpenBot 的 Bot 没有模板链接，不写 templateUrl，装法是复制安装提示词，一定要有 ROLE.md",
      "enum": ["Grok Bot", "OpenBot"]
    },
    "templateUrl": {
      "description": "x.ai 模板分享链接。Grok Bot 必填，OpenBot 的 Bot 不写",
      "type": "string",
      "pattern": "^https://x\\.ai/bot/[A-Za-z0-9_-]+$"
    },
    "templateVersion": {
      "description": "审过的模板版本号（x.ai 模板的 activeVersion）。网站投稿和 Issue 投稿自动填，维护者复核后改；投稿人不用填。",
      "type": "integer",
      "minimum": 1
    },
    "addedAt": {
      "description": "上架日期，YYYY-MM-DD，「最新」排序用",
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "prerequisites": {
      "description": "导入前要准备什么。没有就写「无」。可以写一句话，也可以写成列表。",
      "anyOf": [
        { "type": "string", "minLength": 1, "maxLength": 200 },
        { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1, "maxLength": 100 } }
      ]
    },
    "quotaCost": { "description": "额度消耗", "enum": ["低", "中", "高"] },
    "permissions": {
      "description": "会用到的权限，从固定列表里选；一个都不用就写 []",
      "type": "array",
      "uniqueItems": true,
      "items": { "enum": ["云电脑文件", "本机文件", "浏览器 Cookie", "外部账号", "联网", "定时自动运行", "代我发消息"] }
    },
    "pitch": {
      "description": "自荐台词（可选）。写一句，或写 1 到 3 句互不相同的话；每句 2 到 30 个字",
      "anyOf": [
        { "type": "string", "minLength": 2, "maxLength": 30, "pattern": "^[^<>\"]*$" },
        {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 2, "maxLength": 30, "pattern": "^[^<>\"]*$" }
        }
      ]
    },
    "about": {
      "description": "它能干什么（可选）。里面的字段都可选，写了哪个，详情页就显示哪个",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "intro": { "description": "它是干什么的：你给它什么，它怎么干，交给你什么", "type": "string", "minLength": 10, "maxLength": 200, "pattern": "^[^<>\"]*$" },
        "does": {
          "description": "能帮你做的事，1 到 6 条",
          "type": "array",
          "minItems": 1,
          "maxItems": 6,
          "items": { "type": "string", "minLength": 2, "maxLength": 40, "pattern": "^[^<>\"]*$" }
        },
        "trial": {
          "description": "试跑句：点导入时复制到剪贴板，进 App 粘贴就能直接出结果的一段话，自带示例材料。可以换行。",
          "type": "string",
          "minLength": 10,
          "maxLength": 300,
          "pattern": "^[^<>\"]*$"
        },
        "starters": {
          "description": "导入后可以直接发的第一句话，1 到 3 条",
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "items": { "type": "string", "minLength": 2, "maxLength": 60, "pattern": "^[^<>\"]*$" }
        },
        "skills": {
          "description": "自带技能，1 到 16 个（外部收录用；非外部收录以 skills/ 目录为准）",
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "does"],
            "properties": {
              "name": { "description": "技能名", "type": "string", "minLength": 1, "maxLength": 30, "pattern": "^[^<>\"]*$" },
              "does": { "description": "这个技能做什么", "type": "string", "minLength": 2, "maxLength": 60, "pattern": "^[^<>\"]*$" }
            }
          }
        },
        "routines": {
          "description": "定时任务，1 到 12 个",
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["what", "when", "default", "quiet"],
            "properties": {
              "what": { "description": "这个任务做什么", "type": "string", "minLength": 2, "maxLength": 60, "pattern": "^[^<>\"]*$" },
              "when": { "description": "什么时候跑，比如「每周一早上 9 点」", "type": "string", "minLength": 2, "maxLength": 40, "pattern": "^[^<>\"]*$" },
              "default": { "description": "导入后默认开还是关", "enum": ["开", "关", "未说明"] },
              "quiet": { "description": "没有新内容时还发不发消息", "enum": ["不打扰", "照发", "未说明"] }
            }
          }
        },
        "fit": { "description": "适合谁", "type": "string", "minLength": 2, "maxLength": 60, "pattern": "^[^<>\"]*$" },
        "notFit": { "description": "不适合谁", "type": "string", "minLength": 2, "maxLength": 60, "pattern": "^[^<>\"]*$" },
        "cnFit": { "description": "国内可用性", "enum": ["好", "一般"] },
        "cnNote": { "description": "国内用要知道什么", "type": "string", "minLength": 2, "maxLength": 80, "pattern": "^[^<>\"]*$" }
      }
    },
    "forkedFrom": {
      "description": "改编自哪个 Bot 的 slug（可选）",
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "projectUrl": {
      "description": "源项目地址（可选）。Bot 是照着某个开源项目做的时候填，比如它的 GitHub 仓库",
      "type": "string",
      "maxLength": 200,
      "pattern": "^https://[^\\s<>\"]+$"
    },
    "external": { "description": "外部收录（可选）。为 true 时 ROLE.md、DESIGN.md、skills、截图都不强制；OpenBot 的 Bot 仍然要有 ROLE.md。", "type": "boolean" }
  },
  "allOf": [
    {
      "if": {
        "properties": { "external": { "const": true } },
        "required": ["external"]
      },
      "then": {},
      "else": {
        "properties": { "author": { "type": "object", "required": ["name", "github"] } }
      }
    },
    {
      "if": {
        "properties": { "platform": { "const": "OpenBot" } },
        "required": ["platform"]
      },
      "then": {},
      "else": { "required": ["templateUrl"] }
    }
  ]
}

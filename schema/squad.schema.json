{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jakob52123/bot-zhipin/schema/squad.schema.json",
  "title": "squad.yaml",
  "description": "一支小队的编制表。成员可以是货架上的 Bot（写 bot），也可以是现场新写的岗位（写 role 和 brief）。",
  "type": "object",
  "additionalProperties": false,
  "required": ["slug", "name", "tagline", "formation", "origin", "author", "addedAt", "members"],
  "properties": {
    "slug": {
      "description": "和文件夹同名。只能用小写字母、数字和短横线，2 到 40 个字符。",
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "minLength": 2,
      "maxLength": 40
    },
    "name": { "description": "小队的名字", "type": "string", "minLength": 1, "maxLength": 20, "pattern": "^[^<>\"]*$" },
    "tagline": { "description": "一句话介绍这支队", "type": "string", "minLength": 4, "maxLength": 40, "pattern": "^[^<>\"]*$" },
    "formation": {
      "description": "队形。带队：一个队长派活；接力：一个做完交给下一个；搭伙：各干各的，放在一起用",
      "enum": ["带队", "接力", "搭伙"]
    },
    "origin": {
      "description": "这支队是怎么来的",
      "enum": ["原作者成套", "本站编队", "社区投稿"]
    },
    "author": {
      "description": "设计这支队的人",
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "description": "作者名字", "type": "string", "minLength": 1, "maxLength": 40 },
        "github": {
          "description": "GitHub 用户名，不带 @",
          "type": "string",
          "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9]|-(?=[A-Za-z0-9])){0,38}$"
        },
        "url": { "description": "作者主页，以 https:// 开头", "type": "string", "pattern": "^https://" }
      }
    },
    "addedAt": {
      "description": "上架日期，YYYY-MM-DD",
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "members": {
      "description": "成员，2 到 6 个（Grok Bot 一个群最多 6 个 Bot）。每个成员二选一：货架上的 Bot 写 bot；货架上没有、要现场新建的岗位写 role 和 brief",
      "type": "array",
      "minItems": 2,
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "does"],
        "properties": {
          "bot": {
            "description": "货架上这个 Bot 的 slug（和 role 二选一）",
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
            "minLength": 2,
            "maxLength": 40
          },
          "role": {
            "description": "新写岗位的代号（和 bot 二选一）：小写字母、数字和短横线，flow 里用它指这个成员",
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
            "minLength": 2,
            "maxLength": 40
          },
          "brief": { "description": "新写岗位的岗位说明：在 Grok Bot 里新建一个 Bot，把这段发给它。写清职责、输入、产出、不做什么、什么时候找用户（只在写 role 时填）", "type": "string", "minLength": 20, "maxLength": 2000 },
          "title": { "description": "它在队里的岗位，比如「队长」", "type": "string", "minLength": 2, "maxLength": 12, "pattern": "^[^<>\"]*$" },
          "does": { "description": "它在队里负责什么", "type": "string", "minLength": 4, "maxLength": 40, "pattern": "^[^<>\"]*$" },
          "lead": { "description": "是不是队长（可选）", "type": "boolean" },
          "optional": { "description": "是不是可以不装（可选，默认 false）", "type": "boolean" }
        }
      }
    },
    "flow": {
      "description": "谁把什么交给谁（可选）",
      "type": "array",
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["from", "to", "what"],
        "properties": {
          "from": { "description": "交出的一方：成员的 slug，或 you（代表用户本人）", "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$", "minLength": 2, "maxLength": 40 },
          "to": { "description": "接手的一方：成员的 slug，或 you（代表用户本人）", "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$", "minLength": 2, "maxLength": 40 },
          "what": { "description": "交接的东西", "type": "string", "minLength": 2, "maxLength": 20, "pattern": "^[^<>\"]*$" }
        }
      }
    },
    "setup": {
      "description": "导入之后的接线步骤（可选）",
      "type": "array",
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "detail"],
        "properties": {
          "title": { "description": "这一步做什么", "type": "string", "minLength": 2, "maxLength": 20, "pattern": "^[^<>\"]*$" },
          "detail": { "description": "具体怎么做", "type": "string", "minLength": 4, "maxLength": 140 }
        }
      }
    },
    "kickoff": { "description": "发给队长的组队口令，页面上可以一键复制（可选）", "type": "string", "minLength": 10, "maxLength": 500 },
    "tryout": { "description": "组好以后发的第一句话（可选）", "type": "string", "minLength": 4, "maxLength": 100 },
    "notes": {
      "description": "要知道的事（可选）",
      "type": "array",
      "maxItems": 6,
      "items": { "type": "string", "minLength": 4, "maxLength": 120 }
    },
    "missing": {
      "description": "原套装里有、本站没收的成员（可选）",
      "type": "array",
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "does"],
        "properties": {
          "name": { "description": "这个成员的名字", "type": "string", "minLength": 1, "maxLength": 40, "pattern": "^[^<>\"]*$" },
          "does": { "description": "它原本负责什么", "type": "string", "minLength": 4, "maxLength": 60, "pattern": "^[^<>\"]*$" }
        }
      }
    }
  }
}
